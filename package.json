{
  "name": "digitaletude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n web,admin,api -c green,magenta,blue \"yarn dev\" \"yarn --cwd ../digitaletude-admin dev\" \"yarn --cwd ../digitaletude-admin dev:api\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
