    "@primeuix/utils": "^0.7.2",
    "class-variance-authority": "^0.7.1",
    "primereact": "^11.0.0-rc.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-primeui": "^0.6.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
