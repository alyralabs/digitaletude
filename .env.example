# PrimeUI license key (free Community tier available) — see CLAUDE.md stack notes.
# Copy this file to .env and fill in the values.
VITE_PRIMEUI_LICENSE=

# Supabase (frontend needs only the public/anon pair — never the service key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API origin for prod builds; leave empty in dev (Vite proxies /api to :8080)
VITE_API_URL=
