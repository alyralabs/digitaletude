# Copy this file to .env and fill in the values.

# PrimeUI license key — see CLAUDE.md stack notes. Optional: only removes the
# "Invalid PrimeUI License" watermark. Free Community tier license key from
# your account at https://primereact.org (Dashboard -> License Keys).
VITE_PRIMEUI_LICENSE=

# Settings -> API -> Project URL (same Supabase project the local admin
# writes to). Public pages read PostgREST/Storage on this origin directly —
# there is no deployed backend.
VITE_SUPABASE_URL=

# Settings -> API -> Project API keys -> anon public key. Safe to ship to
# the browser (reads are gated by RLS) — never put the service_role/secret
# key here.
VITE_SUPABASE_ANON_KEY=
