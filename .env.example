# Copy this file to .env and fill in the values.

# PrimeUI license key — see CLAUDE.md stack notes. Optional: only removes the
# "Invalid PrimeUI License" watermark. Free Community tier license key from
# your account at https://primereact.org (Dashboard -> License Keys).
VITE_PRIMEUI_LICENSE=

# Settings -> API -> Project URL (same Supabase project as the API server's
# SUPABASE_URL).
VITE_SUPABASE_URL=

# Settings -> API -> Project API keys -> anon public key. This one is safe to
# ship to the browser — never put the service_role/secret key here.
VITE_SUPABASE_ANON_KEY=

# API origin for prod builds (e.g. https://api.example.com, no trailing
# slash); leave empty in dev — Vite proxies /api to the Go server on :8080.
VITE_API_URL=
